{
	"name": "tobimori/kirby-seo",
	"description": "The default choice for SEO on Kirby: Implement technical SEO & Meta best practices with ease and provide an easy-to-use editor experience",
	"type": "kirby-plugin",
	"version": "2.0.1",
	"license": "proprietary",
	"homepage": "https://github.com/tobimori/kirby-seo#readme",
	"authors": [
		{
			"name": "Tobias Möritz",
			"email": "tobias@moeritz.io"
		}
	],
	"autoload": {
		"psr-4": {
			"tobimori\\Seo\\": "classes"
		}
	},
	"require": {
		"php": ">=8.3.0",
		"getkirby/composer-installer": "^1.2.1"
	},
	"suggest": {
		"ext-imagick": "Rasterize non-resizable images (SVG, etc.) for AI alt text generation",
		"league/html-to-markdown": "Enable automatic conversion for LLM-friendly Markdown responses",
		"tobimori/kirby-queues": "Enable background processing support",
		"getkirby/cli": "Enable background processing support",
		"spatie/schema-org": "Enable the Schema.org support (^5.0)"
	},
	"conflict": {
		"spatie/schema-org": "<5.0"
	},
	"require-dev": {
		"carthage-software/mago": "^1.58.2",
		"getkirby/cli": "^1.8.0",
		"tobimori/kirby-queues": "^1.1.0",
		"spatie/schema-org": "^5.0",
		"getkirby/cms": "^5.0.0",
		"tobimori/kirby-agents": "^0.1.1",
		"league/html-to-markdown": "^5.1"
	},
	"scripts": {
		"analyze": "mago analyze",
		"dist": "composer install --no-dev --optimize-autoloader",
		"fix": [
			"mago lint --fix",
			"mago fmt"
		],
		"fmt": "mago fmt",
		"fmt:check": "mago fmt --check",
		"lint": "mago lint"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"carthage-software/mago": true,
			"getkirby/composer-installer": true
		}
	},
	"extra": {
		"kirby-cms-path": false
	}
}
